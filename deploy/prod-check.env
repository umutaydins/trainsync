# DEV-ONLY dummy values for `make prod-check` (and the CI prod-check job): they only exist so
# compose.prod.yml renders and starts. Never use them for a real deployment. TOKEN_ENCRYPTION_KEY
# is added by scripts/prod_check.py: the Fernet encoding of "dev-only-fernet-key-not-for-use!".
TRAINSYNC_TAG=prodcheck
PUBLIC_API_BASE_URL=http://localhost:18080
POSTGRES_PASSWORD=dev-only-postgres-password
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=dev-only-client-secret
STRAVA_WEBHOOK_VERIFY_TOKEN=dev-only-verify-token
STATE_SIGNING_KEY=dev-only-state-signing-key
API_KEYS=dev-key-1
GATEWAY_PORT=18080
# Public half of a throwaway age keypair whose identity was discarded: nothing can decrypt these.
BACKUP_AGE_RECIPIENT=age1fd5an3vk5qjqkxlle4e87ws732xf6vpzll3t5s5khapkmpnzfasqpchepy
