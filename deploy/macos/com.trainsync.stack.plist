<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template, installed by `scripts/mac-prod.sh install-agent` (P7.2), which replaces __ROOT__ (the
  repo checkout) and __LOG_DIR__ (~/Library/Logs/trainsync) with absolute paths: launchd expands
  neither ~ nor variables. Runs once at login: waits for Docker, then `scripts/mac-prod.sh up`.
  The containers keep themselves running afterwards (restart: unless-stopped).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trainsync.stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/deploy/macos/start-stack.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/stack.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/stack.log</string>
</dict>
</plist>
