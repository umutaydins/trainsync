# Copy to .env and adjust. Never commit a real .env.
# docker compose reads this file too: a secret set here (TOKEN_ENCRYPTION_KEY, STATE_SIGNING_KEY,
# API_KEYS, SERVICE_API_KEYS, STRAVA_CLIENT_SECRET, STRAVA_WEBHOOK_VERIFY_TOKEN,
# DASHBOARD_SESSION_SECRET) replaces the stack's DEV-ONLY default, so replace every change-me below
# with a real value before `docker compose up`.
ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://trainsync:trainsync@localhost:5432/trainsync
REDIS_URL=redis://localhost:6379/0

# Point these at fake_strava for local dev (http://localhost:8001/api/v3, http://localhost:8001/oauth).
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
STRAVA_OAUTH_BASE_URL=https://www.strava.com/oauth
# Browser-facing OAuth base for the authorize redirect; empty = same as STRAVA_OAUTH_BASE_URL.
STRAVA_OAUTH_PUBLIC_BASE_URL=
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=change-me
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me
# Set after creating the webhook subscription with Strava.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Circuit breaker (per process): consecutive failed calls before it opens, seconds until a probe.
STRAVA_BREAKER_FAILURE_THRESHOLD=5
STRAVA_BREAKER_COOLDOWN_S=30

# Fernet key(s), comma-separated; the first encrypts, all decrypt (key rotation). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key
# Any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SIGNING_KEY=change-me
# Comma-separated API keys accepted in the X-API-Key header. A key acts as the owner (scripts,
# curl); people sign in with email + password and get a session token (ADR 0034).
API_KEYS=dev-key-1,dev-key-2
# The bot's key(s): the only keys that may send X-Acting-User, i.e. act as the user a Telegram
# chat is linked to (ADR 0036). The public gateway strips that header.
SERVICE_API_KEYS=dev-bot-key

# ---------------------------------------------------------------- accounts (P8.1, ADR 0034)
# The owner account: migration 0016 gives every existing row to this email, and
# `uv run python scripts/owner.py set-password` creates it / sets its password. Set it BEFORE
# `alembic upgrade head` on a database with data.
OWNER_EMAIL=owner@example.com
# invite (the owner hands out codes: scripts/invite.py) | open | closed.
REGISTRATION_MODE=invite
# Sessions slide: each use extends them by SESSION_TTL_DAYS, never past SESSION_MAX_AGE_DAYS
# from sign-in. The last-seen time is written at most every SESSION_TOUCH_INTERVAL_S.
SESSION_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
SESSION_TOUCH_INTERVAL_S=3600
INVITE_TTL_DAYS=7
# Owner-made password reset links (no email delivery yet).
RESET_TTL_MINUTES=60
# Brute-force guard: failures per email before a lockout, and per client address.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=20
REGISTER_MAX_PER_HOUR=5
# Strava backfill pages per job run; then the job yields so other users' syncs get a turn.
BACKFILL_PAGES_PER_JOB=10

# ---------------------------------------------------------------- Telegram bot + notifications
# All optional. Empty token = the bot only serves metrics, and no notifications are sent.
# Create a bot with @BotFather; never commit the token.
TELEGRAM_BOT_TOKEN=
# Chats are linked to accounts with a one-time code from the dashboard (/link <code>, ADR 0036);
# an unlinked chat only gets a "link your account" hint. Migration 0017 links this chat (the
# notify chat, else the first allowlisted one) to the owner; afterwards both are only the
# owner's fallback for stack alerts.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_CHAT_ID=
# The bot's @username without the @, for the dashboard's "open the bot" link. Empty = no link.
TELEGRAM_BOT_USERNAME=
# Minutes a link code stays valid; seconds the bot caches chat -> user.
TELEGRAM_LINK_CODE_TTL_MINUTES=10
BOT_CHAT_CACHE_S=60
TELEGRAM_API_BASE_URL=https://api.telegram.org
# The read API the bot calls, and its key (empty = the first of SERVICE_API_KEYS).
BOT_API_BASE_URL=http://localhost:8000
BOT_API_KEY=
BOT_METRICS_PORT=9101
# Web dashboard base URL; notifications link to <url>/activities/<id>. Empty = no link.
DASHBOARD_PUBLIC_URL=
# Wording of bot replies, notifications and the assistant (ADR 0016).
# BOT_TONE: neutral | hardcore (a blunt tough-love coach, mild profanity). BOT_LANG: en | tr.
BOT_TONE=neutral
# The default language; each chat can switch with /lang (stored in the database, ADR 0031).
BOT_LANG=en
# Coach intensity (P6.11, ADR 0030): normal | savage. savage is an explicit opt-in to an
# unrestricted, roasting coach (no profanity limit) and works with BOT_TONE=hardcore, in Turkish
# and English (ADR 0031). The guardrails hold in every intensity: never body/weight/appearance, no slurs,
# no push through pain or illness, no pressure to eat below the nutrition target. /yumusak in the
# chat turns on a 24-hour soft mode, /sert ends it.
BOT_INTENSITY=normal
# Savage profanity (P6.13, ADR 0032): roast (swearing only in the roasts) | max (every savage
# message swears). /swear max|roast in the chat overrides it per chat. Pain, illness and distress
# always get a calm reply without swearing.
BOT_PROFANITY=roast
# Savage food roast: a day's free sugar (sweets, desserts, sugary drinks, NOVA 4; never fruit,
# vegetables or plain dairy) above this many grams is called out on the next /eat.
SUGAR_LIMIT_G=50
# One /eat item with more than this much sugar per 100 g gets a roast (UK "high" mark).
HIGH_SUGAR_PER_100G=22.5
# Named in the calm reply to distress talk (guilt, purging, not eating, self-hate).
EMERGENCY_NUMBER=112
# Timed coach messages (reminders before/at a planned workout, nudges, rest over, verdicts).
# Empty = on when TELEGRAM_BOT_TOKEN and a chat are set.
COACH_MESSAGES_ENABLED=
# Start time of program days without their own (local time, CHECKIN_TZ).
WORKOUT_REMINDER_TIME=18:00
# No proactive coach message in this local window (may wrap midnight).
QUIET_HOURS=23:00-07:00
# Your own extra lines for the savage pack (git-ignored); see config/messages.local.example.yaml.
COACH_MESSAGES_FILE=config/messages.local.yaml
# Natural-language questions in the bot (Claude tool use over the read API). Empty key = off.
ANTHROPIC_API_KEY=
# Claude model id for questions; also passed through by docker-compose.yml.
ASSISTANT_MODEL=claude-sonnet-5-5
# Questions per chat per hour, and per user per day (cost/abuse guard, counted in Redis).
ASSISTANT_RATE_LIMIT_PER_HOUR=20
ASSISTANT_DAILY_LIMIT=50

# Browser URLs the OAuth callback may redirect back to (exact match, comma-separated), e.g. the
# web dashboard's sync page. Empty = the callback always answers with JSON.
OAUTH_RETURN_TO_ALLOWLIST=http://localhost:3000/sync

# ---- Web dashboard (web/, Next.js). Server-side only; never exposed to the browser.
# Where the web server reaches the API. It holds no API key: each browser signs in with email +
# password and its API session token travels sealed in the session cookie (ADR 0034).
TRAINSYNC_API_URL=http://localhost:8000
# The dashboard's own URL (OAuth return_to; also the only Origin the BFF accepts for writes, so
# open the dashboard at exactly this URL).
WEB_PUBLIC_URL=http://localhost:3000
# Encrypts the session cookie (AES-256-GCM; >= 32 chars), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# Session cookie `Secure` flag; defaults to true when NODE_ENV=production. Set false only for
# plain-HTTP setups other than localhost.
DASHBOARD_COOKIE_SECURE=
# Display time zone (inlined at build time).
NEXT_PUBLIC_TZ=Europe/Istanbul

# ---------------------------------------------------------------- nutrition (P6.4)
# Open Food Facts food lookup (public API, no key). false = only the local food list is used.
OPENFOODFACTS_ENABLED=true
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
# OFF asks clients to identify themselves: app/version (+contact URL).
OPENFOODFACTS_USER_AGENT="trainsync/0.1 (+https://github.com/umutaydins/trainsync)"
# Seconds; on a timeout the lookup answers with local results only.
OPENFOODFACTS_TIMEOUT_S=3

# ---- Training (P6.3) ----
# Plate calculator: bar weight and plate inventory as <kg>x<pairs> (pairs = plates per side).
GYM_BAR_KG=20
GYM_PLATES=25x2,20x2,15x2,10x2,5x2,2.5x2,1.25x2
# Double progression: kg added once every set hits the top of the rep range (ADR 0018).
PROGRESSION_INCREMENT_KG=2.5
PROGRESSION_LOWER_BODY_INCREMENT_KG=5

# ---- Daily check-in (P6.9, ADR 0020) ----
# The evening "did you train?" prompt in Telegram. Empty = on when TELEGRAM_BOT_TOKEN is set.
CHECKIN_ENABLED=
# Local wall-clock time of the prompt, and the zone. CHECKIN_TZ is also the bot's "today" for
# /log, /eat, /kcal and /weight.
CHECKIN_TIME=21:00
CHECKIN_TZ=Europe/Istanbul
# One reminder this many minutes after the prompt if nothing was answered; 0 = no reminder.
CHECKIN_REMINDER_MINUTES=90

# ---- Progress statistics (P8.10, P8.11, ADR 0038) ----
# Windows of at least this many days are cached in Redis (keyed by the user's data version).
STATS_CACHE_MIN_DAYS=180
STATS_CACHE_TTL_S=86400
# e1RM trend and PRs use working sets of at most this many reps (Epley).
STATS_E1RM_MAX_REPS=10
# Monday (last week) and 1st-of-month (last month) digests in Telegram, at this local time.
# Empty = on when TELEGRAM_BOT_TOKEN is set; each user can switch them off in their settings.
STATS_DIGEST_ENABLED=
STATS_DIGEST_TIME=09:00

# ---- Stack alerts (P7.8, ADR 0027) ----
# The worker sends one Telegram message when a condition starts and one when it clears (to
# TELEGRAM_NOTIFY_CHAT_ID; off without a bot token). Thresholds:
ALERT_CIRCUIT_OPEN_MINUTES=30
ALERT_BACKUP_MAX_AGE_HOURS=36
ALERT_SYNC_STALE_HOURS=2
# Folder with the trainsync-*.dump.age backups; empty = backup age not checked (compose.prod.yml
# mounts the backup folder read-only into the worker and sets this).
BACKUP_DIR=
