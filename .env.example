# Copy to .env and adjust. Never commit a real .env.
ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://trainsync:trainsync@localhost:5432/trainsync
REDIS_URL=redis://localhost:6379/0

# Point these at fake_strava for local dev (http://localhost:8001/api/v3, http://localhost:8001/oauth).
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
STRAVA_OAUTH_BASE_URL=https://www.strava.com/oauth
# Browser-facing OAuth base for the authorize redirect; empty = same as STRAVA_OAUTH_BASE_URL.
STRAVA_OAUTH_PUBLIC_BASE_URL=
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=change-me
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me
# Set after creating the webhook subscription with Strava.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Circuit breaker (per process): consecutive failed calls before it opens, seconds until a probe.
STRAVA_BREAKER_FAILURE_THRESHOLD=5
STRAVA_BREAKER_COOLDOWN_S=30

# Fernet key(s), comma-separated; the first encrypts, all decrypt (key rotation). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key
# Any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SIGNING_KEY=change-me
# Comma-separated API keys accepted in the X-API-Key header.
API_KEYS=dev-key-1,dev-key-2

# ---------------------------------------------------------------- Telegram bot + notifications
# All optional. Empty token = the bot only serves metrics, and no notifications are sent.
# Create a bot with @BotFather; never commit the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot answers; every other chat gets no reply.
TELEGRAM_ALLOWED_CHAT_IDS=
# Chat for new-activity notifications; empty = the first allowlisted chat.
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
# The read API the bot calls, and its key (empty = the first of API_KEYS).
BOT_API_BASE_URL=http://localhost:8000
BOT_API_KEY=
BOT_METRICS_PORT=9101
# Web dashboard base URL; notifications link to <url>/activities/<id>. Empty = no link.
DASHBOARD_PUBLIC_URL=
# Wording of bot replies, notifications and the assistant (ADR 0016).
# BOT_TONE: neutral | hardcore (a blunt tough-love coach, mild profanity). BOT_LANG: en | tr.
BOT_TONE=neutral
BOT_LANG=en
# Natural-language questions in the bot (Claude tool use over the read API). Empty key = off.
ANTHROPIC_API_KEY=
# Claude model id for questions; also passed through by docker-compose.yml.
ASSISTANT_MODEL=claude-sonnet-5-5
# Questions per chat per hour (cost/abuse guard, counted in Redis).
ASSISTANT_RATE_LIMIT_PER_HOUR=20

# Browser URLs the OAuth callback may redirect back to (exact match, comma-separated), e.g. the
# web dashboard's sync page. Empty = the callback always answers with JSON.
OAUTH_RETURN_TO_ALLOWLIST=http://localhost:3000/sync

# ---- Web dashboard (web/, Next.js). Server-side only; never exposed to the browser.
# Where the web server reaches the API, and the key it sends as X-API-Key (one of API_KEYS).
TRAINSYNC_API_URL=http://localhost:8000
TRAINSYNC_API_KEY=dev-key-1
# Browser-facing URLs: the API (Connect Strava link) and the dashboard itself (OAuth return_to;
# also the only Origin the BFF accepts for writes, so open the dashboard at exactly this URL).
TRAINSYNC_PUBLIC_API_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
# Single-user access gate. The session secret signs the cookie (>= 32 chars), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# Session cookie `Secure` flag; defaults to true when NODE_ENV=production. Set false only for
# plain-HTTP setups other than localhost.
DASHBOARD_COOKIE_SECURE=
# Display time zone (inlined at build time).
NEXT_PUBLIC_TZ=Europe/Istanbul
