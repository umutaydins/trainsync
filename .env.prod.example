# Production settings for compose.prod.yml (P7.1). Copy to .env.prod (git-ignored), fill in every
# value, keep it readable by your user only (chmod 600 .env.prod). compose refuses to start while a
# required value is missing. Never reuse the DEV-ONLY defaults from docker-compose.yml.

# Image tag: leave empty. `make deploy` (P7.5) tags images with the git SHA and records it in
# ~/Library/Application Support/trainsync/deploy-state, which scripts/mac-prod.sh starts at login.
# Set it by hand only to pin a tag for a manual run.
TRAINSYNC_TAG=

# Public HTTPS base of the backend (Tailscale Funnel, P7.3), e.g. https://mac.tail1234.ts.net
# (no trailing slash; `scripts/funnel.sh status` prints the right value). It derives the Strava
# OAuth redirect URI (<base>/auth/strava/callback) and is the base of the webhook callback_url
# (<base>/webhooks/strava) and of the web app's TRAINSYNC_API_URL.
PUBLIC_API_BASE_URL=

# Database password (any long random string; only the containers use it).
POSTGRES_PASSWORD=

# Strava API application (docs/strava-setup.md).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SIGNING_KEY=
# Comma-separated tooling keys (scripts, curl); each acts as the owner. The web holds no key.
API_KEYS=
# The bot's key (ADR 0036): the only key that may act as a linked user. Required since Phase 8:
# generate one like STATE_SIGNING_KEY before deploying.
SERVICE_API_KEYS=

# Accounts (P8.1, ADR 0034). OWNER_EMAIL must be set BEFORE the Phase 8 migrations run: 0016
# gives all existing data to this account. Then set its password once:
#   docker compose -f compose.prod.yml --env-file .env.prod exec api \
#     python -m trainsync.entrypoints.cli owner set-password
OWNER_EMAIL=
# invite | open | closed
REGISTRATION_MODE=invite
# The bot's @username (no @) for the dashboard's "link Telegram" step.
TELEGRAM_BOT_USERNAME=

# Where the OAuth callback may send the browser back to (comma-separated, exact), e.g.
# https://<web>/sync,https://<web>/onboarding,https://<web>/me/connections
OAUTH_RETURN_TO_ALLOWLIST=
DASHBOARD_PUBLIC_URL=

# Telegram bot and notifications (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_CHAT_ID=
BOT_TONE=neutral
BOT_LANG=en
# BOT_LANG is the default; /lang in the chat switches it at runtime (ADR 0031).
# Coach (P6.11, ADR 0030): savage = unrestricted roasting (with BOT_TONE=hardcore, either
# language), your explicit choice; the guardrails always hold. Own lines: config/messages.local.yaml.
BOT_INTENSITY=normal
# P6.13, ADR 0032: roast | max (swearing in every savage message); /swear overrides it per chat.
BOT_PROFANITY=roast
SUGAR_LIMIT_G=50
HIGH_SUGAR_PER_100G=22.5
EMERGENCY_NUMBER=112
WORKOUT_REMINDER_TIME=18:00
QUIET_HOURS=23:00-07:00
CHECKIN_TZ=Europe/Istanbul
# Progress digests (P8.11): Monday and the 1st at this local time; empty = on with the bot.
STATS_DIGEST_ENABLED=
STATS_DIGEST_TIME=09:00

# Optional: natural-language questions in the bot.
ANTHROPIC_API_KEY=

# Backups (P7.4, docs/operations.md "Backups and restore"). Generate the key pair with age-keygen
# inside the backup image; the recipient (age1…, public) goes here, the identity file stays in
# your password manager and at BACKUP_AGE_IDENTITY_FILE (outside iCloud, chmod 600).
BACKUP_AGE_RECIPIENT=
# Optional: enables the weekly restore check (skipped and reported on Telegram without it).
BACKUP_AGE_IDENTITY_FILE=
# Must exist; default: ~/Library/Mobile Documents/com~apple~CloudDocs/trainsync-backups
BACKUP_HOST_DIR=
BACKUP_TIME=03:30
BACKUP_TZ=Europe/Istanbul
# ISO weekday of the restore check (1 = Monday … 7 = Sunday).
RESTORE_CHECK_WEEKDAY=7

# Stack alerts from the worker (P7.8, docs/operations.md "Alerts"): Telegram, to the notify chat.
ALERT_CIRCUIT_OPEN_MINUTES=30
ALERT_BACKUP_MAX_AGE_HOURS=36
ALERT_SYNC_STALE_HOURS=2

# Gateway: local port Funnel forwards to; true serves /docs and /openapi.json publicly.
# The demo gateway (P7.9) listens on DEMO_GATEWAY_PORT (default 8081), Funnel port 8443.
GATEWAY_PORT=8080
EXPOSE_DOCS=false
