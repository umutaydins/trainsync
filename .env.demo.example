# Public read-only demo (P7.9): copy to .env.demo (git-ignored) and fill in, then
#   docker compose --env-file .env.demo -f compose.demo.yml up -d --build
# The demo holds synthetic data only and refuses every write, so nothing here protects personal
# data; the key just keeps the demo API from being an open endpoint for anyone who finds it.

# X-API-Key of the demo API, for your own tooling (curl, scripts). The web does not use it: the
# Vercel *Preview* env signs in to the published demo account instead (see the end of this file).
# Generate one: python3 -c "import secrets; print('demo-' + secrets.token_urlsafe(24))"
DEMO_API_KEY=

# Optional.
# DEMO_GATEWAY_PORT=8081       # scripts/funnel.sh on demo forwards :8443 here
# DEMO_EXPOSE_DOCS=true        # /docs and /openapi.json through the gateway
# DEMO_TZ=Europe/Istanbul      # the demo's "today"
# TRAINSYNC_TAG=local          # image tag of trainsync-demo / trainsync-demo-gateway

# The demo account is seeded with the data and is public on purpose (README "Live demo"): sign in
# to the dashboard with demo@trainsync.invalid / trainsync-demo. Sign-in and sign-out are the only
# writes the demo accepts.
